# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored on purpose - never commit real keys.

# Used by the Explainability layer (LLM Explanation) once we reach that stage
ANTHROPIC_API_KEY=

# Used if we query PhishTank's authenticated API (optional, registration is
# currently closed - see data/README.md)
PHISHTANK_API_KEY=

# Backend API settings (used once src/api is built)
API_HOST=0.0.0.0
API_PORT=8000
